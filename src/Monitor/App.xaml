<Application x:Class="Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Monitor"
             
            xmlns:vm="clr-namespace:Monitor.ViewModels"
            xmlns:views="clr-namespace:Monitor.Views.Pages">
    
    

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/VerticalMenuStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/ComponentStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/ContextualMenuStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/DatagridStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <!-- Colores -->
            <SolidColorBrush x:Key="Background1" Color="#232227"/>
            <SolidColorBrush x:Key="Background2" Color="#16151A"/>

            <!-- Fuente -->
            <FontFamily x:Key="AppFont">
                pack://application:,,,/Resources/Fonts/#Montserrat
            </FontFamily>

            <!-- Para TODOS los controles -->
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            </Style>

            <!-- Para textos puros -->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            </Style>
            


            <DataTemplate DataType="{x:Type vm:MenuVNCViewModel}">
                <views:MenuVNCView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:BalanzasViewModel}">
                <views:BalanzasView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DispositivosViewModel}">
                <views:DispositivosView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AnalisisRedViewModel}">
                <views:AnalisisRedView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EscaneoPuertosViewModel}">
                <views:EscaneoPuertosView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ConfiguracionAppViewModel}">
                <views:ConfiguracionAppView/>
            </DataTemplate>

 


        </ResourceDictionary>
        
    </Application.Resources>


</Application>
