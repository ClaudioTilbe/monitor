<Window x:Class="Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Monitor"
        xmlns:anim="clr-namespace:Monitor.Resources.Animations"
        xmlns:conv="clr-namespace:Monitor.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Monitor"
        Height="675" Width="1200"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="/Resources/Icons/favicon.ico"
        Background="{StaticResource Background2}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
    </Window.Resources>
    

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome 
     ResizeBorderThickness="0"
     CaptionHeight="0"
     CornerRadius="0"
     GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="320"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <anim:GridLengthAnimation
                                                    Storyboard.TargetProperty="Width"
                                                    From="320"
                                                    To="80"
                                                    Duration="0:0:0.5">

                                                <anim:GridLengthAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </anim:GridLengthAnimation.EasingFunction>

                                            </anim:GridLengthAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <anim:GridLengthAnimation
                                                    Storyboard.TargetProperty="Width"
                                                    From="80"
                                                    To="320"
                                                    Duration="0:0:0.5">

                                                <anim:GridLengthAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </anim:GridLengthAnimation.EasingFunction>

                                            </anim:GridLengthAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Botones ventana -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" >

            <Button Style="{StaticResource WindowButtonStyle}" Click="MinimizeWindow" >
                <Image Source="/Resources/Icons/minimize.png" Width="20" Height="20"/>
            </Button>

            <Button Style="{StaticResource WindowButtonStyle}" Click="MaximizeWindow">
                <Image Source="/Resources/Icons/maximize.png" Width="20" Height="20"/>
            </Button>

            <Button Style="{DynamicResource CloseButtonStyle}" Click="CloseWindow" >
                <Image Source="/Resources/Icons/close.png" Width="20" Height="20"/>
            </Button>

        </StackPanel>



        <!-- TEXTO -->
        <TextBlock x:Name="PageTitulo"
                Text="{Binding Titulo}"
                Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="2"
                Width="400"
                Margin="40, 10, 0, 0"
                Foreground="White"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>



        <!-- CONTENIDO -->
        <ContentControl Grid.Row="2"
                Grid.Column="1"
                Content="{Binding CurrentView}" />






        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Background="{StaticResource Background1}" MouseDown="DragWindow">

            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



            <!-- LOGO + TÍTULO -->
            <StackPanel Orientation="Horizontal" Margin="20,10,0,10">

                <StackPanel.RenderTransform>
                    <TranslateTransform X="0"/>
                </StackPanel.RenderTransform>

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Style.Triggers>

                            <!-- COLLAPSE: mueve a la derecha para quedar centrado -->
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation
                     Storyboard.TargetProperty="Margin"
                     To="15,10,0,10"
                     Duration="0:0:0.35">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation
                     Storyboard.TargetProperty="Margin"
                     To="20,10,0,10"
                     Duration="0:0:0.35">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- ÍCONO -->
                <Image Source="/Resources/Icons/favicon.png"
                         Width="50"
                         Height="50"
                         Margin="0,0,8,0"
                         RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- TEXTO -->
                <TextBlock x:Name="txtLogo"
                 Text="Monitor"
                 Foreground="White"
                 FontSize="30"
                 FontWeight="Bold"
                 VerticalAlignment="Center">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="sbExpand">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0"
                    Value="{x:Static Visibility.Collapsed}"/>
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.30"
                    Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="sbExpand"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

            </StackPanel>



