                        <Image x:Name="imgCollapse"
    Source="/Resources/Icons/collapse.png"
    Width="40"
    Height="40"
    Margin="0,0,10,0"
    RenderOptions.BitmapScalingMode="HighQuality">

                            <Image.RenderTransform>
                                <RotateTransform x:Name="rtCollapse" Angle="0"/>
                            </Image.RenderTransform>

                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>

                                        <!-- COLLAPSE -->
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                    To="180"
                                    Duration="0:0:0.3">

                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>

                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>

                                            <!-- EXPAND -->
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                To="0"
                                Duration="0:0:0.3">

                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>

                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Image.Style>

                            <Image.RenderTransformOrigin>
                                0.5,0.5
                            </Image.RenderTransformOrigin>

                        </Image>
                        <TextBlock Text="Collapse"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="20">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="sbExpand">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
                                                         Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                             Value="{x:Static Visibility.Collapsed}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.30"
                                                             Value="{x:Static Visibility.Visible}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="sbExpand"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </Button>
                


                <Button Style="{StaticResource VerticalMenuButtonStyle}"
                        Command="{Binding GoConfiguracionAppCommand}">

                    <StackPanel Orientation="Horizontal" Margin="40,10,0,10">

                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0"/>
                        </StackPanel.RenderTransform>

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Style.Triggers>

                                    <!-- COLLAPSE: mueve a la derecha para quedar centrado -->
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ThicknessAnimation
Storyboard.TargetProperty="Margin"
To="15,10,0,10"
Duration="0:0:0.35">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut"/>
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ThicknessAnimation
Storyboard.TargetProperty="Margin"
To="40,10,0,10"
Duration="0:0:0.35">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseInOut"/>
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Image Source="/Resources/Icons/configuracion.png" Width="40" Height="40"
                       Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="Configuracion"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="20">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="sbExpand">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames
    Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
        Value="{x:Static Visibility.Collapsed}"/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.30"
        Value="{x:Static Visibility.Visible}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="sbExpand"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </Button>


                <Label x:Name="lblUsuario"
                        Content="{Binding UsuarioInfo}"
                        Foreground="{Binding UsuarioColor}"
                        Padding="0 , 15"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center" />


            </StackPanel>


        </Grid>




        <Grid Grid.ColumnSpan="2"
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}"
              Panel.ZIndex="99999">

            <ContentControl Content="{Binding OverlayContent}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Grid>




    </Grid>






</Window>
