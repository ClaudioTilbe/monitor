<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- SCROLLBAR -->
    <Style x:Key="ScrollBarDark" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">

                        <Track x:Name="PART_Track"
                         IsDirectionReversed="True">

                            <Track.Thumb>
                                <Thumb Margin="2">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumbBorder"
                                              Background="#555"
                                              CornerRadius="5"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBorder"
                                                      Property="Background"
                                                      Value="#888"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                        </Track>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- DATAGRID -->
    <Style x:Key="DataGridEstiloOscuro" TargetType="DataGrid">

        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>

        <!-- Filas -->
        <Setter Property="RowBackground" Value="#232227"/>
        <Setter Property="AlternatingRowBackground" Value="#232227"/>

        <!-- Header -->
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderThickness" Value="0"/>

                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>

        <!-- Filas separación -->
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Margin" Value="0,6,0,4"/>
                    <Setter Property="Background" Value="#232227"/>
                </Style>
            </Setter.Value>
        </Setter>

        <!-- Scroll habilitado -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

    </Style>




</ResourceDictionary>