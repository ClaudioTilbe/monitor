<UserControl x:Class="Monitor.Views.Pages.MenuVNCView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Monitor.Views.Pages"
             xmlns:conv="clr-namespace:Monitor.Converters"
             xmlns:models="clr-namespace:Monitor.Models"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             ToolTipService.InitialShowDelay="1000"
             Background="{StaticResource Background2}" Cursor="">
    
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- BOTÓN VNC -->
        <DataTemplate DataType="{x:Type models:AccesoVNC}">

            <Button Content="{Binding Alias}"
                    Style="{StaticResource btnMonitoreo}"
                    Command="{Binding DataContext.AbrirVNCCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding IP}"/>

        </DataTemplate>

        <!-- TÍTULO -->
        <DataTemplate DataType="{x:Type models:AccesoVNCTitulo}">
            <Label Content="{Binding Texto}"
                   Foreground="White"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </DataTemplate>


        <ContextMenu x:Key="MenuVNC"
             Style="{StaticResource EstiloContextMenu}">

            <MenuItem Header="Asociar IP"
              Style="{StaticResource EstiloMenuItem}"
              Command="{Binding PlacementTarget.Tag.AgregarVNCCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

            <MenuItem Header="Asociar Título"
              Style="{StaticResource EstiloMenuItem}"
              Command="{Binding PlacementTarget.Tag.AgregarTituloCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

            <Separator/>

            <MenuItem Header="Desasociar"
              Style="{StaticResource EstiloMenuItem}"
              Command="{Binding PlacementTarget.Tag.DesasociarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>


        </ContextMenu>
        

    </UserControl.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="45"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1">

            <!-- ELEMENTOS DINÁMICOS (VNC + TITULOS) -->
            <ItemsControl ItemsSource="{Binding ElementosGrid}"
                  Panel.ZIndex="0">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Filas}"
                             Columns="{Binding Columnas}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Grid.Row" Value="{Binding Fila}"/>
                        <Setter Property="Grid.Column" Value="{Binding Columna}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

            </ItemsControl>


            <!-- GUIAS (ENCIMA CUANDO ACTIVAS) -->
            <ItemsControl ItemsSource="{Binding Guias}"
                  Panel.ZIndex="1"
                  Visibility="{Binding MostrarGuias, Converter={StaticResource BoolToVisibility}}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Filas}"
                             Columns="{Binding Columnas}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="2"
                        Background="#22FFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        PreviewMouseLeftButtonDown="OnGuiaLeftClick"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">

                            <Button.ContextMenu>
                                <StaticResource ResourceKey="MenuVNC"/>
                            </Button.ContextMenu>

                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>


        </Grid>



        <Button x:Name="btnModuloAnterior" 
                 Style="{StaticResource btnFlecha}"
                 Cursor="Hand" Opacity="0.8"
                 Grid.Column="0"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Command="{Binding ModuloAnteriorCommand}"
                 Visibility="{Binding PuedeIrAnterior}">

            <Image Source="/Resources/icons/flechaAtras.png" 
                   RenderOptions.BitmapScalingMode="HighQuality"/>

        </Button>


        <Button x:Name="btnModuloSiguiente"
                Style="{StaticResource btnFlecha}"
                Cursor="Hand" Opacity="0.8"
                Grid.Column="3"
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding ModuloSiguienteCommand}"
                Visibility="{Binding PuedeIrSiguiente}">

            <Image Source="/Resources/icons/flechaAdelante.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

        </Button>




        <Button Content="Mostar Guias"
                 Style="{StaticResource btnBlancoGuia}"
                 Grid.Column="2"
                 Grid.Row="3"
                 Command="{Binding ToggleGuiasCommand}"/>

        <Border Grid.Column="1"
                 Grid.Row="3"
                 Margin="0, 0, 10, 0"
                 CornerRadius="4"
                 Background="#22FFFFFF"
                 BorderBrush="#44FFFFFF"
                 BorderThickness="1">

            <Label Content="{Binding Mensaje}"
                    Padding="10, 0, 0, 0"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Foreground="{Binding MensajeColor}"
                    Background="Transparent"/>
            
        </Border>

    </Grid>


</UserControl>
