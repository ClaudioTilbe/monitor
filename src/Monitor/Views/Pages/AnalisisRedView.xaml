<UserControl x:Class="Monitor.Views.Pages.AnalisisRedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Monitor.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="45"/>
        </Grid.ColumnDefinitions>


        <Grid Grid.Column="1" Grid.Row="1">

            <!-- Fondo general (forma redondeada real) -->
            <Border CornerRadius="10"
         Background="#232227"/>

            <!-- Header "falso" redondeado -->
            <Border CornerRadius="10,10,0,0"
                 Background="#0D0D0D"
                 Height="45"
                 VerticalAlignment="Top"
                 IsHitTestVisible="False"
                 Padding="0,0,0,12"/>

            <!-- DataGrid real -->
            <DataGrid  x:Name="dgResultados"
                       ItemsSource="{Binding Resultados}"
                       AutoGenerateColumns="False"
                       IsReadOnly="True"
                       HeadersVisibility="Column"
                       GridLinesVisibility="None"
                       Background="Transparent"
                       BorderThickness="0"
                       Margin="0,0,0,10"
                       Style="{StaticResource DataGridEstiloOscuro}">

                <DataGrid.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarDark}"/>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="*" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding Activo}" Width="*" />
                    <DataGridTextColumn Header="Tiempo (ms)" Binding="{Binding TiempoRespuesta}" Width="*" />
                </DataGrid.Columns>

            </DataGrid>

        </Grid>



        <Grid Grid.Column="3"
           Grid.Row="1" Cursor="">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- parte superior -->
                <RowDefinition Height="*"/>
                <!-- espacio flexible -->
                <RowDefinition Height="Auto"/>
                <!-- parte inferior -->
            </Grid.RowDefinitions>

            <!-- ARRIBA -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="Subred"
                Margin="0,0,0,5"
                Foreground="White"
                FontSize="18"
                FontWeight="Bold"/>

                <TextBox x:Name="txtSubred"
                         Text="{Binding Subred, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         Style="{StaticResource txtFormulario}"/>  

            </StackPanel>

            <!-- ABAJO -->
            <StackPanel Grid.Row="2">

                <Button  Content="Iniciar Escaneo"
                         Command="{Binding IniciarEscaneoCommand}"
                         Height="35"
                         Style="{StaticResource btnVerde}"/>

                <ProgressBar x:Name="pbEscaneo"
                              Value="{Binding Progreso}"
                              Height="20"
                              Margin="5,10,5,5"
                              Minimum="0"
                              Maximum="255"/>

                <TextBlock x:Name="lblProgreso"
                           Text="{Binding ProgresoTexto}" 
                           HorizontalAlignment="Center"
                           Foreground="White"/>

            </StackPanel>

        </Grid>


        <Border  Grid.Column="1"
              Grid.Row="3"
              Grid.ColumnSpan="3"
              CornerRadius="4"
              Background="#22FFFFFF"
              BorderBrush="#44FFFFFF"
              BorderThickness="1">

            <Label  Content="{Binding Mensaje}"
                    Foreground="{Binding MensajeColor}"
                    x:Name="lblMensaje"
                    Padding="10, 0, 0, 0"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Background="Transparent"/>
            
        </Border>

    </Grid>
    
    
</UserControl>
