<UserControl x:Class="Monitor.Views.Pages.ConfiguracionAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Monitor.Views.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="45"/>
        </Grid.ColumnDefinitions>


        <!-- Gateway -->
        <TextBlock  Text="Gateway:"
                 Grid.Row="1"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 Foreground="White"
                 FontSize="20"/>

        <TextBox Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"
         Grid.Row="1" 
         Grid.Column="3"
         Style="{StaticResource txtFormulario}"/>

        <!-- Ruta Nmap -->
        <TextBlock Text="Ruta Nmap:"
                Grid.Row="3"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="White"
                FontSize="20"/>

        <TextBox Text="{Binding RutaNmap, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="3"
                 Grid.Column="3"
                 Style="{StaticResource txtFormulario}"/>

        <!-- Ruta VNC -->
        <TextBlock Text="Ruta VNC:"
                Grid.Row="5"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="White"
                FontSize="20"/>

        <TextBox Text="{Binding RutaVNC, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="5"
                 Grid.Column="3"
                 Style="{StaticResource txtFormulario}"/>


        <!-- Botón guardar -->
        <Button Content="Guardar"
                Command="{Binding GuardarCommand}"
                Grid.Row="7"
                Grid.Column="3"
                Height="35"
                Width="120"
                HorizontalAlignment="Center"
                Style="{StaticResource btnVerde}"/>


        <Border Grid.Column="1"
             Grid.Row="10"
             Grid.ColumnSpan="4"
             CornerRadius="4"
             Background="#22FFFFFF"
             BorderBrush="#44FFFFFF"
             BorderThickness="1">

            <Label Content="{Binding Mensaje}"
                   Foreground="{Binding MensajeColor}"
                   Padding="10,0,0,0"
                   FontSize="16"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   VerticalContentAlignment="Center"
                   Background="Transparent"/>
            
        </Border>

       
    </Grid>

</UserControl>
