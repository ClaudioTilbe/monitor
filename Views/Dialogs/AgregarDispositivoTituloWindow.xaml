<Window x:Class="Monitor.Views.Dialogs.AgregarDispositivoTituloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Monitor.Views.Dialogs"
        mc:Ignorable="d"
        Title="Agregar titulo" 
        Height="370" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Border Padding="15" CornerRadius="10"
         Background="{StaticResource Background2}"
         BorderBrush="#444444"
         BorderThickness="1">

        <Border.RenderTransform>
            <ScaleTransform x:Name="scaleTransform" ScaleX="0.9" ScaleY="0.9"/>
        </Border.RenderTransform>

        <Border.RenderTransformOrigin>
            0.5,0.5
        </Border.RenderTransformOrigin>

        <Grid Background="Transparent"
           FocusManager.FocusedElement="{Binding ElementName=txtTitulo}">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Título -->
            <TextBlock Text="Nuevo Titulo"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Grid.Row="1"
                    FontWeight="Bold"
                    FontSize="24"
                    Foreground="White"/>

            <!-- Label -->
            <TextBlock Text="Titulo :" 
                    Grid.Column="1"
                    Grid.Row="3"
                    Foreground="White"
                    FontSize="18"
                    VerticalAlignment="Center"/>

            <!-- INPUT (Binding!) -->
            <TextBox x:Name="txtTitulo"
                  Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                  Grid.Column="3"
                  Grid.Row="3"
                  Style="{StaticResource txtFormulario}"/>

            <!-- MENSAJE -->
            <Border Grid.Column="1"
                 Grid.ColumnSpan="3"
                 Grid.Row="6"
                 CornerRadius="4"
                 Background="#22FFFFFF"
                 BorderBrush="#44FFFFFF"
                 BorderThickness="1">

                <Label Content="{Binding Mensaje}"
                    Padding="10, 0, 0, 0"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Foreground="White"
                    Background="Transparent"/>
            </Border>

            <!-- BOTONES (COMMANDS!) -->
            <Button Content="Cancelar"
                 Style="{StaticResource btnRojo}"
                 Width="120"
                 HorizontalAlignment="Left"
                 Grid.Column="1"
                 Grid.Row="8"
                 Command="{Binding CancelarCommand}"
                 Cursor="Hand"/>

            <Button Content="Aceptar"
                 Style="{StaticResource btnVerde}"
                 Width="120"
                 HorizontalAlignment="Right"
                 Grid.Column="3"
                 Grid.Row="8"
                 IsDefault="True"
                 Command="{Binding AceptarCommand}"/>

        </Grid>

    </Border>

</Window>
